{
  "info": {
    "_postman_id": "7a14d2fe-972c-44f7-8f22-d244e6247427",
    "name": "FIAP X - VideoManagementService",
    "description": "Runner collection for VideoManagementService local validation. It obtains a Keycloak access token, creates a video, uploads a sample payload using the returned presigned URL, checks MinIO, and validates read/error scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Happy Path",
      "item": [
        {
          "name": "00 - Login Alice In Keycloak",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Keycloak returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.environment.set('accessToken', json.access_token);",
                  "pm.environment.set('aliceAccessToken', json.access_token);",
                  "",
                  "function decodeJwtPayload(token) {",
                  "    const payload = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "    const padded = payload.padEnd(payload.length + (4 - payload.length % 4) % 4, '=');",
                  "    return JSON.parse(atob(padded));",
                  "}",
                  "",
                  "const claims = decodeJwtPayload(json.access_token);",
                  "pm.environment.set('authenticatedUserId', claims.sub);",
                  "pm.environment.set('authenticatedEmail', claims.email);",
                  "pm.environment.set('aliceUserId', claims.sub);",
                  "",
                  "pm.test('Access token has required claims for the API', function () {",
                  "    const aud = Array.isArray(claims.aud) ? claims.aud : [claims.aud];",
                  "    pm.expect(claims.sub).to.be.a('string').and.not.empty;",
                  "    pm.expect(claims.email).to.eql(pm.environment.get('aliceEmail'));",
                  "    pm.expect(claims.iss).to.eql(pm.environment.get('keycloakBaseUrl') + '/realms/fiapx');",
                  "    pm.expect(aud).to.include(pm.environment.get('jwtAudience'));",
                  "    pm.expect(claims.exp).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{keycloakClientId}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{aliceUsername}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{alicePassword}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{keycloakBaseUrl}}/realms/fiapx/protocol/openid-connect/token",
              "host": [
                "{{keycloakBaseUrl}}"
              ],
              "path": [
                "realms",
                "fiapx",
                "protocol",
                "openid-connect",
                "token"
              ]
            }
          },
          "response": []
        },
