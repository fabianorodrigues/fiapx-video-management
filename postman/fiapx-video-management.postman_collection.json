        {
          "name": "02 - Create Video",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const videoFilePath = pm.environment.get('videoFilePath');",
                  "if (!videoFilePath || videoFilePath.includes('C:/Videos/meu-video.mp4')) {",
                  "    throw new Error('Configure videoFilePath com o caminho absoluto de um .mp4 e habilite Settings > Working Directory > Allow reading files outside working directory no Postman.');",
                  "}",
                  "",
                  "const fileName = videoFilePath.split(/[\\\\/]/).filter(Boolean).pop();",
                  "if (!fileName || !fileName.toLowerCase().endsWith('.mp4')) {",
                  "    throw new Error('videoFilePath deve apontar para um arquivo .mp4.');",
                  "}",
                  "",
                  "pm.environment.set('videoFileName', fileName);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Create returns 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const authenticatedUserId = pm.environment.get('authenticatedUserId');",
                  "const minioPublicEndpoint = pm.environment.get('minioPublicEndpoint').replace(/\\/$/, '');",
                  "const minioBucket = pm.environment.get('minioBucket');",
                  "const expectedObjectKey = `videos/${authenticatedUserId}/${json.videoId}/original.mp4`;",
                  "const expectedResultObjectKey = `results/${authenticatedUserId}/${json.videoId}/resultado.zip`;",
                  "const uploadedObjectUrl = `${minioPublicEndpoint}/${minioBucket}/${expectedObjectKey}`;",
                  "",
                  "pm.environment.set('videoId', json.videoId);",
                  "pm.environment.set('uploadUrl', json.uploadUrl);",
                  "pm.environment.set('expectedObjectKey', expectedObjectKey);",
                  "pm.environment.set('expectedResultObjectKey', expectedResultObjectKey);",
                  "pm.environment.set('uploadedObjectUrl', uploadedObjectUrl);",
                  "",
                  "pm.test('Response has expected fields', function () {",
                  "    pm.expect(json.videoId).to.match(/^[0-9a-fA-F-]{36}$/);",
                  "    pm.expect(json.status).to.eql('RECEBIDO');",
                  "    pm.expect(json.uploadUrl).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.expiresInSeconds).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('Presigned URL is public and contains expected object key', function () {",
                  "    pm.expect(json.uploadUrl.startsWith(minioPublicEndpoint)).to.eql(true);",
                  "    pm.expect(json.uploadUrl).to.include(`/${minioBucket}/${expectedObjectKey}`);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"{{videoFileName}}\",\n  \"contentType\": \"{{videoContentType}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{apiBaseUrl}}/videos",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "videos"
              ]
            }
          },
          "response": []
